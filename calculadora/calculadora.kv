CalculadoraDisplay:

<CalculadoraDisplay@BoxLayout>:
    id: calculadora
    orientation: 'vertical'
    padding: 10
    spacing: 10

    # Pantalla de la calculadora
    TextInput:
        id: entrada_texto
        font_size: 40
        multiline: False
        alignment: 'right'
        size_hint_y: 0.2

    # Rejilla de botones
    GridLayout:
        cols: 4
        spacing: 5

        # Fila 1
        Button:
            text: "7"
            on_press: entrada_texto.text += self.text
        Button:
            text: "8"
            on_press: entrada_texto.text += self.text
        Button:
            text: "9"
            on_press: entrada_texto.text += self.text
        Button:
            text: "/"
            on_press: entrada_texto.text += self.text

        # Fila 2
        Button:
            text: "4"
            on_press: entrada_texto.text += self.text
        Button:
            text: "5"
            on_press: entrada_texto.text += self.text
        Button:
            text: "6"
            on_press: entrada_texto.text += self.text
        Button:
            text: "*"
            on_press: entrada_texto.text += self.text

        # Fila 3
        Button:
            text: "1"
            on_press: entrada_texto.text += self.text
        Button:
            text: "2"
            on_press: entrada_texto.text += self.text
        Button:
            text: "3"
            on_press: entrada_texto.text += self.text
        Button:
            text: "-"
            on_press: entrada_texto.text += self.text

        # Fila 4
        Button:
            text: "C"
            on_press: entrada_texto.text = ""
        Button:
            text: "0"
            on_press: entrada_texto.text += self.text
        Button:
            text: "="
            on_press: 
                try: entrada_texto.text = str(eval(entrada_texto.text)) if entrada_texto.text else ""
                except Exception: entrada_texto.text = "Error"
        Button:
            text: "+"
            on_press: entrada_texto.text += self.text
